
# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""

# Database Configuration (Optional)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Server Configuration
PORT=3000
NODE_ENV=development

# Domain Configuration
# DOMAIN: Your frontend deployment domain (used for CORS)
# Development: localhost
# Production: your-frontend-domain.com (e.g., pankeki-portfolio.vercel.app)
DOMAIN="localhost"

# Frontend Configuration (used for CORS)
# Dev: http://localhost:5173
# Prod: https://${DOMAIN} (derived from DOMAIN env var)
FRONTEND_PORT=5173

# Cookie Configuration (for cross-domain authentication)
# Use 'none' for cross-domain deployments (backend on Render, frontend on Vercel)
# Use 'lax' for same-domain or less permissive deployments
# Use 'strict' for same-site requests only
COOKIE_SAMESITE="none"
# Secure flag - REQUIRED when COOKIE_SAMESITE=none (must use HTTPS)
COOKIE_SECURE=false