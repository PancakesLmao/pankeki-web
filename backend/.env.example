# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
# Server Configuration
PORT=3000
NODE_ENV=development
# Domain Configuration (Supports comma-separated list of domains for multiple websites, e.g., "site1.com,site2.com")
DOMAIN="domain1, domain2"
FRONTEND_PORT=5173
# Cookie Configuration (for cross-domain authentication)
# Use 'none' for cross-domain deployments (backend on Render, frontend on Vercel)
# Use 'lax' for same-domain or less permissive deployments
# Use 'strict' for same-site requests only
COOKIE_SAMESITE="none"
# Secure flag - REQUIRED when COOKIE_SAMESITE=none (must use HTTPS)
COOKIE_SECURE=false
