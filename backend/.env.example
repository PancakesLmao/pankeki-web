# Database Configuration (Prisma)
# For Supabase: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Get this from: Supabase Dashboard > Project Settings > Database > Connection String (URI mode)
DATABASE_URL="DATATBASE_CONNECTION_URL"
DIRECT_URL="DIRECT_DATABASE_CONNECTION_URL"
# Supabase Configuration (for auth only)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key
# Server Configuration
PORT=3000
NODE_ENV=development